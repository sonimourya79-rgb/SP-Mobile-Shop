PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/sp-mobile
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5183

ADMIN_NAME=SP Mobile Admin
ADMIN_EMAIL=aa6871678@gmail.com
ADMIN_PASSWORD=change_this_password
ADMIN_PHONE=9653206528

# Image uploads (admin accessory/secondhand photos, customer print-cover photos).
# Leave blank for local development — images just save to server/uploads/ on
# disk. REQUIRED on hosts with an ephemeral filesystem (e.g. Render's free
# tier), where local disk uploads are wiped on every restart/redeploy.
# Free account: https://cloudinary.com/users/register/free — the three
# values below are shown on your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email sending (contact form notifications + admin "send offer" broadcasts),
# via Brevo's HTTP API (https://api.brevo.com) — plain HTTPS, so it works from
# hosts like Render's free tier where outbound SMTP is blocked/unreachable.
# Free account: https://onboarding.brevo.com/account/register — after signup,
# verify a "sender" (e.g. spmobiletechnology@gmail.com) under Senders & IP >
# Senders, then create an API key under SMTP & API > API Keys and paste it
# below. Leave BREVO_API_KEY blank to disable email sending — the site still
# works, emails are just skipped with a warning in the server log.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=aa6871678@gmail.com
EMAIL_FROM_NAME=SP Mobile

# Lets you trigger `npm run seed`'s logic over HTTP via POST /api/dev/seed,
# for hosts without shell access (e.g. Render's free tier). Set this to a
# long random value and keep it private — anyone with it can (re-)run the
# seed script against your live database.
SEED_SECRET=change_this_to_a_long_random_secret
